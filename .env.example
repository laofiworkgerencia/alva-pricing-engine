# Copia este archivo a .env.local para desarrollo local con `vercel dev`,
# o configura la misma variable en el dashboard de Vercel (Settings →
# Environment Variables) para producción. Nunca commitees el valor real.
GEMINI_API_KEY=

# Almacenamiento en la nube TEMPORAL (ver README y src/cloudStore.ts).
# VITE_SUPABASE_ANON_KEY es una key pública por diseño (RLS es la
# seguridad real) — a diferencia de GEMINI_API_KEY, sí puede ir en el
# cliente. Estas dos deben llevar el prefijo VITE_ para que Vite las
# incluya en el bundle del navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
